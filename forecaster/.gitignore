# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Data and artifacts — captures and databases are large and reproducible
data/
artifacts/
*.db
*.db-wal
*.db-shm
*.ndjson
*.ndjson.gz

# Reports
#
# Generated reports are committed, deliberately. They are small, and they are
# the evidence behind the claims in VALIDATION.md — a reader should be able to
# check the numbers rather than take the prose on trust. Only ad-hoc ones are
# ignored.
*.report.json
reports/tmp/

# Node (see web/.gitignore for the rest)
node_modules/

# Secrets
.env
.env.local
.env*.local

# OS
.DS_Store
Thumbs.db

# Live-run outputs are NOT committed, unlike the others in reports/.
#
# verify.json, backtest.json and conformance.json are reproducible from the code
# in this tree: anyone can run `make verify` and get them back. These two depend
# on which exchange the machine could reach and what the market did at the time,
# so a committed copy is a claim nobody else can check — and a copy produced on a
# blocked network would be a record of failure presented as evidence.
reports/live-check.json
reports/live-validation.json
