# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Data and artifacts — captures and databases are large and reproducible
data/
artifacts/
*.db
*.db-wal
*.db-shm
*.ndjson
*.ndjson.gz

# Reports
#
# Generated reports are committed, deliberately. They are small, and they are
# the evidence behind the claims in VALIDATION.md — a reader should be able to
# check the numbers rather than take the prose on trust. Only ad-hoc ones are
# ignored.
*.report.json
reports/tmp/

# Node (see web/.gitignore for the rest)
node_modules/

# Secrets
.env
.env.local
.env*.local

# OS
.DS_Store
Thumbs.db
