# Forecaster configuration.
#
# Every value is read by the Python engine only. Nothing here reaches the
# browser, and nothing here should be prefixed NEXT_PUBLIC_.
#
# The system runs with none of this set. The default venue's market data is
# public — no API key, no secret, nothing to leak — which is a large part of why
# it is the default.
#
# Copy to `.env` and adjust. `.env` is git-ignored.

# ---------------------------------------------------------------------------
# Where market data comes from
# ---------------------------------------------------------------------------
# simulated  a seeded synthetic market. The DEFAULT, deliberately: a
#            misconfigured deployment silently producing live-looking numbers
#            from an unknown source would be the worst possible failure, and a
#            simulator that announces itself is the safest.
# live       a real exchange. Set FORECASTER_VENUE too.
# replay     a recorded capture. Set FORECASTER_CAPTURE.
FORECASTER_PROVIDER=simulated

# coinbase (default) · binance · kraken
# Coinbase needs no key for market data and works in the US.
# binance.com is blocked to US users; its data is deeper where it is reachable.
FORECASTER_VENUE=coinbase

# websocket (default) or poll.
# The polling transport is not a toy: WebSocket upgrades are blocked on many
# corporate networks, and on the environment this project was built in.
FORECASTER_TRANSPORT=websocket

FORECASTER_SYMBOLS=BTC-USD,ETH-USD

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite for development. Any PostgreSQL URL works unchanged — the schema is
# SQLAlchemy Core and portable:
#   postgresql+psycopg://user:password@host:5432/forecaster
FORECASTER_DB=sqlite:///./data/forecaster.db
FORECASTER_DATA_DIR=./data
FORECASTER_ARTIFACT_DIR=./artifacts

# ---------------------------------------------------------------------------
# The quarantine switch
# ---------------------------------------------------------------------------
# A model trained on simulated data may not serve a live forecast. Leave this
# off unless you know exactly why you are turning it on: a simulator-trained
# model produces confident numbers that describe a piece of software rather than
# a market, and nothing in the output would look wrong.
#
# Even when set, the warning still reaches the interface.
FORECASTER_ALLOW_ML_LIVE=false

# ---------------------------------------------------------------------------
# Reproducibility
# ---------------------------------------------------------------------------
# The simulator is deterministic: the same seed gives the same market, the same
# training data and the same metrics.
FORECASTER_SEED=20260909

# Book depth captured per snapshot, and how often.
FORECASTER_BOOK_DEPTH=10
FORECASTER_BOOK_SNAPSHOT_MS=1000

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# Where the browser reaches the engine in development. In production the engine
# serves the exported front end itself, so this is unused.
FORECASTER_API=http://127.0.0.1:8099
