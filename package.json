{
  "name": "breakpoint",
  "private": true,
  "version": "0.1.0",
  "description": "BREAKPOINT — a physics-first 3D pool game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.0",
    "eslint": "^9.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
