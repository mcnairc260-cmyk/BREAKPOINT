{
  "name": "proofhound",
  "version": "0.1.0",
  "private": true,
  "description": "ProofHound \u2014 trace claims back to the evidence.",
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "next start -p 3210",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
