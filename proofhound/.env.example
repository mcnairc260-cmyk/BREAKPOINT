# ProofHound configuration.
#
# Every value here is read on the server only. No key is ever exposed to the
# browser, and nothing in this file should be prefixed NEXT_PUBLIC_.
# Copy to `.env.local` and fill in what you have. ProofHound runs with none of
# them set — it simply says so rather than pretending to have done research.

# ---------------------------------------------------------------------------
# Language model (optional)
# ---------------------------------------------------------------------------
# Used only to refine claim parsing and entity extraction. With no key set,
# the deterministic rules engine runs and the workspace reports
# "Analysis engine: heuristic".
#
# Set exactly one, or set PROOFHOUND_LLM_PROVIDER to choose between several.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# PROOFHOUND_LLM_PROVIDER=anthropic | openai | gemini | heuristic

# ---------------------------------------------------------------------------
# Web research (optional)
# ---------------------------------------------------------------------------
# With one of these set, ProofHound performs real web search and the workspace
# is labelled LIVE. Without them it falls back to the built-in demonstration
# corpora, which are labelled DEMONSTRATION everywhere they appear, and to an
# explicit "no sources retrieved" state for anything the corpora do not cover.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# `file` (default) writes one JSON document per investigation under .data/.
# `memory` keeps them in process only — useful for read-only filesystems.
# PROOFHOUND_STORE=file
